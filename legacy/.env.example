# Copy to .env. Never commit .env or share these secrets.
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# From your Stripe dashboard. Use TEST keys while developing.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Create a long random value, e.g. openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Set once using the bootstrap instructions below; do not put the seed in source control.
CREATOR_TOTP_SECRET=REPLACE_WITH_BASE32_SECRET

# Optional product configuration
EVENT_NAME=DL Events — African Culture, Football & Night Party
CURRENCY=gbp
