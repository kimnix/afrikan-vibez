# ---------------------------------------------------------------------------
# AFRICAN VIBES — server environment (copy to .env in this folder)
# Never commit the real .env. Never expose these values to the browser.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public URL of the API (used for Stripe redirect URLs and links in emails)
BASE_URL=http://localhost:4000
# Origin of the web client, allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Deployment (production)
# Setting NODE_ENV=production enables secure cookies, strict startup
# validation, trusted-proxy handling and single-origin SPA serving. The
# server refuses to boot if JWT secrets are still development defaults,
# DATABASE_URL is missing, or the origins are still localhost.
# ---------------------------------------------------------------------------
# Trust the first reverse-proxy hop so client IPs (rate limits) are correct.
# TRUST_PROXY=true
# Serve the built SPA (client/dist) from the API on one origin.
# Defaults to true in production, false in development.
# SERVE_CLIENT=true

# ---------------------------------------------------------------------------
# Database
# The repo ships a local, user-owned PostgreSQL helper (see scripts/db.sh).
# Default local connection for that instance:
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/african_vibes

# ---------------------------------------------------------------------------
# Auth secrets — generate long random values, e.g. `openssl rand -hex 32`
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Payments
# PAYMENTS_MODE=stripe uses real Stripe test keys. PAYMENTS_MODE=mock runs a
# fully local sandbox checkout so the whole flow works without network access.
# ---------------------------------------------------------------------------
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ---------------------------------------------------------------------------
# Event defaults (overridable per event in the admin dashboard)
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=gbp
DEFAULT_TIMEZONE=Europe/London

# ---------------------------------------------------------------------------
# Demo content & accounts (development only — see db:seed / db:bootstrap-admin)
# `npm run db:seed` loads the demo event, promos and the accounts below. In
# production that content is skipped unless SEED_DEMO_EVENT=true /
# SEED_DEMO_ACCOUNTS=true. For a real launch, provision an admin instead with:
#   ADMIN_EMAIL=you@yourdomain.com ADMIN_PASSWORD='…' npm run db:bootstrap-admin
# Change these before seeding anything non-local.
# ---------------------------------------------------------------------------
SEED_DEMO_EVENT=
SEED_DEMO_ACCOUNTS=
SEED_ADMIN_EMAIL=admin@africanvibes.test
SEED_ADMIN_PASSWORD=Admin123!
SEED_CUSTOMER_EMAIL=customer@africanvibes.test
SEED_CUSTOMER_PASSWORD=Customer123!
# Used by `npm run db:bootstrap-admin` (real production admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ---------------------------------------------------------------------------
# Notifications (leave blank in development to log instead of send)
# ---------------------------------------------------------------------------
EMAIL_FROM="African Vibes <tickets@example.com>"
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Uploads
# Optional: where admin gallery images are written (defaults to ./uploads)
# ---------------------------------------------------------------------------
# UPLOAD_DIR=uploads
